/* ==========================================================================
   VAN PHONG SMART AGRI - MODERN LIGHT BOTANICAL & EMERALD DESIGN SYSTEM
   ========================================================================== */

* {
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", "Arial", sans-serif;
    color: #0f172a;
}

QMainWindow, QWidget#centralWidget {
    background-color: #f8fafc;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #f1f5f9;
    width: 6px;
    margin: 0;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #10b981;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #f1f5f9;
    height: 6px;
    margin: 0;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background: #cbd5e1;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: #10b981;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #ffffff;
    color: #475569;
    border-top: 1px solid #e2e8f0;
    font-size: 11px;
    font-weight: 500;
}

/* Tables */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    color: #0f172a;
    gridline-color: #f1f5f9;
    selection-background-color: #d1fae5;
    selection-color: #065f46;
    font-size: 11px;
}
QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #f1f5f9;
}
QTableWidget::item:selected {
    background-color: #d1fae5;
    color: #065f46;
    font-weight: 700;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #065f46;
    font-weight: 800;
    font-size: 11px;
    padding: 8px;
    border: none;
    border-bottom: 1.5px solid #cbd5e1;
}

/* Inputs */
QLineEdit {
    background-color: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    color: #0f172a;
    padding: 6px 10px;
    font-size: 12px;
    selection-background-color: #10b981;
    selection-color: #ffffff;
}
QLineEdit:focus {
    border: 1.5px solid #10b981;
    background-color: #ffffff;
}

QComboBox {
    background-color: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 6px;
    color: #0f172a;
    padding: 4px 10px;
    font-size: 11px;
}
QComboBox:hover {
    border-color: #10b981;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    selection-background-color: #d1fae5;
    selection-color: #065f46;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    outline: none;
}

QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 6px;
    color: #0f172a;
    padding: 4px 8px;
    font-size: 11px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #10b981;
}

/* Checkboxes */
QCheckBox {
    color: #0f172a;
    font-size: 11px;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid #cbd5e1;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #10b981;
    border-color: #10b981;
}

/* Virtual Keyboard Styling (Light Mode) */
QWidget#virtualKeyboard {
    background-color: #f1f5f9;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
}
QPushButton#kbKey {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#kbKey:hover {
    background-color: #f8fafc;
    border-color: #10b981;
}
QPushButton#kbKey:pressed {
    background-color: #d1fae5;
    color: #065f46;
}
QPushButton#kbBackspace, QPushButton#kbClear {
    background-color: #fee2e2;
    color: #dc2626;
    border: 1px solid #fca5a5;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}
QPushButton#kbBackspace:hover, QPushButton#kbClear:hover {
    background-color: #ef4444;
    color: white;
}
QPushButton#kbShift, QPushButton#kbMode {
    background-color: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}
QPushButton#kbEnter, QPushButton#kbDone {
    background-color: #10b981;
    color: #ffffff;
    border: 1px solid #059669;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}
QPushButton#kbEnter:hover, QPushButton#kbDone:hover {
    background-color: #059669;
    color: white;
}
QPushButton#kbSpace {
    background-color: #ffffff;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}
QPushButton#kbLeft, QPushButton#kbRight, QPushButton#kbTab, QPushButton#kbHide {
    background-color: #ffffff;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
}
