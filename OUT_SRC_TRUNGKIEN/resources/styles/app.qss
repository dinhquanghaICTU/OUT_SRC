}

/* LeNam device list v2 - mobile home style */
QWidget#DeviceManagementPage,
QWidget#deviceMainPanel,
QWidget#devicePageContent {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
                                stop:0 #8fc6e8, stop:.48 #d7d5c0, stop:1 #b37a31);
}
QScrollArea { background: transparent; border: none; }
QLabel#devicePageTitle {
    color: white;
    font-size: 58px;
    font-weight: 950;
    letter-spacing: -2px;
}
QLabel#devicePageSubtitle { color: rgba(255,255,255,180); }
QLabel#deviceSectionTitle {
    color: white;
    font-size: 36px;
    font-weight: 900;
    margin-top: 18px;
    margin-bottom: 8px;
}
QLabel#deviceSectionHint {
    color: rgba(255,255,255,180);
    font-size: 13px;
    font-weight: 700;
}
QLabel#liveBadge,
QPushButton#refreshDevicesButton {
    background: rgba(82,99,103,150);
    color: white;
    border: none;
    border-radius: 28px;
    padding: 10px 18px;
    font-weight: 900;
}
QFrame#ownedDeviceCard,
QFrame#availableDeviceCard {
    background: rgba(255,255,255,238);
    border: none;
    border-radius: 26px;
}
QFrame#ownedDeviceCard[deviceType="temperature_sound"],
QFrame#availableDeviceCard[deviceType="temperature_sound"] {
    background: rgba(255,255,255,245);
}
QFrame#ownedDeviceCard[deviceType="environment"],
QFrame#availableDeviceCard[deviceType="environment"] {
    background: rgba(111,82,39,185);
}
QFrame#ownedDeviceCard[deviceType="uv_pressure"],
QFrame#availableDeviceCard[deviceType="uv_pressure"] {
    background: rgba(255,255,255,238);
}
QFrame#ownedDeviceCard:hover,
QFrame#availableDeviceCard:hover {
    background: rgba(255,255,255,255);
}
QLabel#deviceTypeIcon,
QLabel#availableDeviceIcon {
    min-width: 58px;
    max-width: 58px;
    min-height: 58px;
    max-height: 58px;
    border-radius: 29px;
    background: #ffc800;
    color: white;
    font-size: 31px;
    font-weight: 950;
}
QLabel#devicePrimaryMetric {
    color: #111111;
    font-size: 0px;
    max-height: 0px;
}
QLabel#deviceSecondaryMetric {
    color: #8c8c8c;
    font-size: 20px;
    font-weight: 700;
}
QLabel#deviceCardName,
QLabel#availableDeviceId {
    color: #111111;
    font-size: 26px;
    font-weight: 950;
}
QLabel#deviceCardId,
QLabel#deviceCardType,
QLabel#availableDeviceHint {
    color: #8d8d8d;
    font-size: 17px;
    font-weight: 700;
}
QFrame#ownedDeviceCard[deviceType="environment"] QLabel#deviceCardName,
QFrame#ownedDeviceCard[deviceType="environment"] QLabel#deviceSecondaryMetric,
QFrame#ownedDeviceCard[deviceType="environment"] QLabel#deviceCardId,
QFrame#availableDeviceCard[deviceType="environment"] QLabel {
    color: white;
}
QLabel#onlinePill,
QLabel#offlinePill {
    background: rgba(0,0,0,75);
    color: white;
    border-radius: 15px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 900;
}
QPushButton#claimDeviceButton,
QPushButton#relayToggle {
    background: rgba(0,0,0,105);
    color: white;
    border-radius: 14px;
    min-height: 26px;
    font-weight: 900;
}
QLabel#irDetectedStatus,
QLabel#irClearStatus {
    background: rgba(0,0,0,88);
    color: white;
    border-radius: 14px;
    padding: 5px;
    font-weight: 900;
}
QLabel#deviceEmptyState {
    background: rgba(255,255,255,155);
    color: #4e5f63;
    border: none;
    border-radius: 22px;
    padding: 20px;
    font-weight: 800;
}

/* LeNam device card horizontal fix */
QFrame#ownedDeviceCard {
    min-width: 350px;
    max-width: 350px;
    min-height: 112px;
    max-height: 112px;
    border-radius: 24px;
}
QLabel#deviceCardName {
    font-size: 22px;
    font-weight: 950;
    color: #111111;
    max-height: 28px;
}
QLabel#deviceCardId {
    font-size: 13px;
    font-weight: 800;
    color: #7f8790;
    max-height: 18px;
}
QLabel#deviceSecondaryMetric {
    font-size: 14px;
    font-weight: 850;
    color: #777777;
    max-height: 20px;
}
QLabel#onlinePill,
QLabel#offlinePill {
    min-width: 92px;
    max-width: 92px;
    min-height: 28px;
    max-height: 28px;
    border-radius: 14px;
    padding: 0;
}
QLabel#deviceTypeIcon {
    min-width: 62px;
    max-width: 62px;
    min-height: 62px;
    max-height: 62px;
    border-radius: 31px;
}
QFrame#ownedDeviceCard[deviceType="environment"] QLabel#deviceCardName,
QFrame#ownedDeviceCard[deviceType="environment"] QLabel#deviceSecondaryMetric,
QFrame#ownedDeviceCard[deviceType="environment"] QLabel#deviceCardId {
    color: #ffffff;
}


/* LeNam wider device cards */
QFrame#ownedDeviceCard {
    min-width: 410px;
    max-width: 410px;
}
QLabel#deviceCardName {
    font-size: 21px;
}
QLabel#onlinePill,
QLabel#offlinePill {
    min-width: 96px;
    max-width: 96px;
}


/* LeNam device spacing/color fix */
QFrame#ownedDeviceCard {
    min-width: 450px;
    max-width: 450px;
    min-height: 122px;
    max-height: 122px;
}
QLabel#deviceCardName {
    font-size: 22px;
    max-height: 30px;
}
QLabel#deviceCardId {
    font-size: 13px;
    max-height: 18px;
}
QLabel#deviceSecondaryMetric {
    font-size: 14px;
    max-height: 20px;
}
QLabel#onlinePill {
    background: #27c46b;
    color: white;
    min-width: 102px;
    max-width: 102px;
}
QLabel#offlinePill {
    background: #9ca3af;
    color: white;
    min-width: 102px;
    max-width: 102px;
}
QLabel#irDetectedStatus {
    background: #ef4444;
    color: white;
    min-width: 150px;
    max-width: 150px;
}
QLabel#irClearStatus {
    background: #27c46b;
    color: white;
    min-width: 150px;
    max-width: 150px;
}


/* LeNam device typography cleanup */
QLabel#devicePageTitle {
    font-size: 46px;
    letter-spacing: -1px;
}
QLabel#deviceSectionTitle {
    font-size: 30px;
    margin-top: 14px;
    margin-bottom: 6px;
}
QFrame#availableDeviceCard {
    min-width: 450px;
    max-width: 450px;
    min-height: 122px;
    max-height: 122px;
    border-radius: 24px;
}
QLabel#availableDeviceId {
    font-size: 22px;
    font-weight: 950;
    color: #111111;
    max-height: 30px;
}
QLabel#deviceCardType {
    font-size: 14px;
    font-weight: 850;
    color: #7f8790;
    max-height: 20px;
}
QLabel#availableDeviceHint {
    font-size: 14px;
    font-weight: 850;
    color: #7f8790;
    max-height: 20px;
}
QLabel#availableDeviceIcon {
    min-width: 62px;
    max-width: 62px;
    min-height: 62px;
    max-height: 62px;
    border-radius: 31px;
}
QPushButton#claimDeviceButton {
    background: #27c46b;
    color: white;
    border-radius: 16px;
    font-weight: 950;
}

/* LeNam smaller device card titles */
QLabel#deviceCardName,
QLabel#availableDeviceId {
    font-size: 18px;
    font-weight: 900;
    max-height: 24px;
}
QLabel#deviceCardId,
QLabel#deviceSecondaryMetric,
QLabel#deviceCardType,
QLabel#availableDeviceHint {
    font-size: 12px;
    max-height: 18px;
}
QFrame#ownedDeviceCard,
QFrame#availableDeviceCard {
    min-height: 116px;
    max-height: 116px;
}


/* LeNam device title space fix */
QLabel#deviceTypeIcon,
QLabel#availableDeviceIcon {
    min-width: 54px;
    max-width: 54px;
    min-height: 54px;
    max-height: 54px;
    border-radius: 27px;
}
QLabel#onlinePill,
QLabel#offlinePill {
    min-width: 92px;
    max-width: 92px;
}
QLabel#irDetectedStatus,
QLabel#irClearStatus {
    min-width: 132px;
    max-width: 132px;
}
QLabel#deviceCardName,
QLabel#availableDeviceId {
    font-size: 17px;
}


/* LeNam final card width and relay visibility */
QFrame#ownedDeviceCard,
QFrame#availableDeviceCard {
    min-width: 520px;
    max-width: 520px;
}
QLabel#deviceCardName,
QLabel#availableDeviceId {
    font-size: 17px;
    font-weight: 950;
}
QLabel#onlinePill,
QLabel#offlinePill {
    min-width: 96px;
    max-width: 96px;
}
QLabel#irDetectedStatus,
QLabel#irClearStatus {
    min-width: 150px;
    max-width: 150px;
}
QPushButton#relayToggle {
    min-width: 150px;
    max-width: 150px;
    min-height: 32px;
    max-height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    text-align: left;
}

/* LeNam header navigation */
QWidget#sideBar {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
                                stop:0 #0b1020, stop:.55 #123d5d, stop:1 #075feb);
    border-right: none;
    border-bottom: 1px solid rgba(255,255,255,45);
}
QWidget#sideBar QPushButton {
    min-width: 112px;
    max-width: 150px;
    min-height: 44px;
    max-height: 44px;
    border-radius: 22px;
    padding: 0 18px;
    text-align: center;
    color: #d8ecff;
    background: transparent;
    font-size: 14px;
    font-weight: 900;
}
QWidget#sideBar QPushButton:hover {
    background: rgba(255,255,255,32);
    color: white;
}
QWidget#sideBar QPushButton:checked {
    background: rgba(255,255,255,235);
    color: #075feb;
    border-left: none;
}
QWidget#sideBar QPushButton#logoutButton {
    background: rgba(255,255,255,24);
    color: white;
}
QWidget#sideBar QLabel#sideLogo {
    background: white;
    border-radius: 26px;
}

/* LeNam dashboard no inner sidebar */
QFrame#lenamDashboardContent {
    border-radius: 0;
}
QLabel#lenamDashboardHeading {
    font-size: 22px;
    font-weight: 900;
}


