}
QPushButton#lenamOrangeButton {
    background: #ffad18;
    color: white;
    border: none;
    border-radius: 9px;
    min-height: 22px;
    padding: 0 12px;
    font-size: 9px;
    font-weight: 900;
}
QChartView#lenamChartView {
    background: transparent;
