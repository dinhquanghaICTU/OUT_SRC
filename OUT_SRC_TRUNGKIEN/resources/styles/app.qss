/* ==========================================================================
   DARK CYBER HUD THEME - 7 INCH EMBEDDED DISPLAY (800x480)
   OUT_SRC_TRUNGKIEN
   ========================================================================== */

* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", sans-serif;
    outline: none;
}

QMainWindow,
QWidget#LoginPage,
QWidget#DashboardPage,
QWidget#DeviceManagementPage,
QWidget#devicePageContent,
QWidget#deviceMainPanel,
QWidget#HistoryPage,
QWidget#AlertPage,
QWidget#UserManagementPage {
    background-color: #070d1e;
    color: #ecf2ff;
}

QLabel {
    color: #ecf2ff;
}

/* --- ScrollBars --- */
QScrollBar:vertical {
    background: #070d1e;
    width: 6px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #1e3a8a;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: #070d1e;
    height: 6px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #1e3a8a;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Sidebar --- */
QWidget#sideBar,
QFrame#sideBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0f1c3f, stop:1 #070d1e);
    border-right: 1.5px solid #1c2b54;
}

QWidget#sideBar QPushButton,
QFrame#sideBar QPushButton {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 800;
    text-align: left;
}

QWidget#sideBar QPushButton:hover,
QFrame#sideBar QPushButton:hover {
    background-color: #172554;
    color: #38bdf8;
}

QWidget#sideBar QPushButton:checked,
QFrame#sideBar QPushButton:checked {
    background-color: #0284c7;
    color: #ffffff;
    font-weight: 900;
}

QPushButton#sidebarToggleButton {
    background: #0e1938;
    color: #38bdf8;
    border: 1px solid #223565;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
}

/* --- Common Labels & Titles --- */
QLabel#devicePageTitle,
QLabel#usersPageTitle,
QLabel#dashboardTitle,
QLabel#historyCardTitle {
    color: #38bdf8;
    font-size: 15px;
    font-weight: 900;
}

QLabel#devicePageSubtitle,
QLabel#dashboardSubtitle,
QLabel#deviceSectionHint {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
}

QLabel#deviceSectionTitle {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 900;
}

QLabel#liveBadge,
QLabel#dashboardUpdatedAt {
    color: #10b981;
    font-size: 10px;
    font-weight: 900;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 2px 6px;
}

QLabel#deviceEmptyState {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
    padding: 12px;
}

/* --- Common Buttons & Tabs --- */
QPushButton#deviceViewTabButton,
QPushButton#dashboardTab {
    background: #0e1938;
    color: #cbd5e1;
    border: 1px solid #223565;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 800;
}

QPushButton#deviceViewTabButton:checked,
QPushButton#dashboardTabActive {
    background: #0284c7;
    color: #ffffff;
    border: 1px solid #38bdf8;
    font-weight: 900;
}

QPushButton#deviceViewTabButton:hover,
QPushButton#dashboardTab:hover {
    background: #1e293b;
    color: #ffffff;
}

QPushButton#historySearchButton,
QPushButton#usersAddButton,
QPushButton#claimDeviceSaveButton,
QPushButton#loginButton {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 900;
    padding: 5px 14px;
}

QPushButton#historySearchButton:hover,
QPushButton#usersAddButton:hover,
QPushButton#claimDeviceSaveButton:hover,
QPushButton#loginButton:hover {
    background-color: #059669;
}

QPushButton#refreshDevicesButton,
QPushButton#historyZoomButton {
    background-color: #0e1938;
    color: #38bdf8;
    border: 1px solid #223565;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
}

QPushButton#refreshDevicesButton:hover,
QPushButton#historyZoomButton:hover {
    background-color: #1e293b;
}

/* --- Inputs, Combos, DateEdits --- */
QLineEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #0f1c3f;
    color: #ffffff;
    border: 1px solid #233870;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 700;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1.5px solid #38bdf8;
}

QComboBox QAbstractItemView {
    background-color: #0e1938;
    color: #ffffff;
    selection-background-color: #0284c7;
    border: 1px solid #223565;
}

/* --- Badges & Pills --- */
QLabel#logStatBadge,
QLabel#historyRecordBadge {
    background: #0e1938;
    color: #94a3b8;
    border: 1px solid #1e293b;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#logStatBadgeOnline {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 900;
}

QLabel#onlinePill {
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 9px;
    font-weight: 900;
}

QLabel#offlinePill {
    background: rgba(239, 68, 68, 0.2);
    color: #f87171;
    border: 1px solid #dc2626;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 9px;
    font-weight: 900;
}

/* --- Tables --- */
QTableWidget {
    background-color: #0c1630;
    color: #ffffff;
    gridline-color: #1c2b54;
    border: 1px solid #1c2b54;
    border-radius: 8px;
    font-size: 10px;
}

QTableWidget QHeaderView::section {
    background-color: #111d3d;
    color: #cbd5e1;
    font-weight: 800;
    font-size: 10px;
    padding: 4px;
    border: none;
    border-bottom: 1px solid #1c2b54;
}

QTableWidget::item {
    padding: 2px 4px;
    color: #ffffff;
}

QTableWidget::item:selected {
    background-color: #1e3a8a;
    color: #ffffff;
}

/* --- Device Cards --- */
QFrame#ownedDeviceCard,
QFrame#availableDeviceCard {
    background-color: #0e1938;
    border: 1px solid #1c2b54;
    border-radius: 10px;
}

QFrame#ownedDeviceCard:hover,
QFrame#availableDeviceCard:hover {
    border-color: #38bdf8;
    background-color: #122149;
}

QLabel#deviceTypeIcon,
QLabel#availableDeviceIcon {
    font-size: 20px;
    color: #38bdf8;
    background: #0f1c3f;
    border: 1px solid #233870;
    border-radius: 8px;
    padding: 4px 8px;
}

QLabel#deviceCardName {
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
}

QLabel#deviceCardId,
QLabel#availableDeviceId {
    color: #94a3b8;
    font-size: 9px;
    font-weight: 600;
}

QLabel#devicePrimaryMetric {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 900;
}

QLabel#deviceSecondaryMetric,
QLabel#deviceCardType,
QLabel#availableDeviceHint {
    color: #cbd5e1;
    font-size: 9px;
    font-weight: 600;
}

QPushButton#claimDeviceButton {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 800;
    padding: 4px 8px;
}

QPushButton#claimDeviceButton:hover {
    background-color: #059669;
}

/* --- Dashboard Smart Cards & Scene Buttons --- */
QFrame#dashboardWeatherCard,
QFrame#dashboardSceneCard,
QFrame#dashboardMediaCard,
QFrame#dashboardCameraCard {
    background-color: #0d1733;
    border: 1px solid #1c2b54;
    border-radius: 8px;
}

QPushButton[objectName^="dashboardScene_"] {
    background-color: #0e1938;
    color: #ffffff;
    border: 1px solid #1c2b54;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 10px;
}

QPushButton[objectName^="dashboardScene_"]:hover {
    background-color: #172554;
    border-color: #38bdf8;
    color: #38bdf8;
}

QPushButton[objectName^="dashboardScene_"]:checked {
    background-color: #0284c7;
    color: #ffffff;
    border: 1.5px solid #38bdf8;
    font-weight: 900;
}

QFrame#dashboardMetricPill {
    background-color: #0e1938;
    border: 1px solid #223565;
    border-radius: 6px;
}

QLabel#dashboardClock {
    color: #ffffff;
    font-size: 20px;
    font-weight: 900;
    font-family: monospace;
}

QLabel#dashboardDate {
    color: #cbd5e1;
    font-size: 10px;
    font-weight: 700;
}

QLabel#dashboardWeatherChip {
    background: #0e1938;
    color: #38bdf8;
    border: 1px solid #223565;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 800;
}

QLabel#dashboardMetricSmallValue {
    color: #ffffff;
    font-size: 14px;
    font-weight: 900;
}

QLabel#dashboardMetricSmallUnit {
    color: #94a3b8;
    font-size: 9px;
    font-weight: 700;
}

/* --- History Page & Charts --- */
QFrame#historyChartCard {
    background-color: #0d1733;
    border: 1px solid #1c2b54;
    border-radius: 8px;
}

QFrame#historyStatCard {
    background-color: #0e1938;
    border: 1px solid #223565;
    border-radius: 6px;
}

QLabel#historyStatTitle {
    color: #cbd5e1;
    font-size: 9px;
    font-weight: 700;
}

QLabel#historyStatValue {
    color: #38bdf8;
    font-size: 12px;
    font-weight: 900;
}

/* --- User Management Detail Panel --- */
QFrame#userDetailPanel {
    background-color: #0d1733;
    border: 1px solid #1c2b54;
    border-radius: 8px;
}

/* --- Virtual Keyboard --- */
QWidget#virtualKeyboard {
    background-color: #0b152d;
    border-top: 1.5px solid #1c2b54;
}

QWidget#virtualKeyboard QPushButton {
    background-color: #172554;
    color: #ffffff;
    border: 1px solid #1e3a8a;
    border-radius: 5px;
    font-size: 13px;
    font-weight: 800;
    min-height: 28px;
}

QWidget#virtualKeyboard QPushButton:hover {
    background-color: #1d4ed8;
    border-color: #38bdf8;
}

QWidget#virtualKeyboard QPushButton:pressed {
    background-color: #0284c7;
}

QWidget#virtualKeyboard QPushButton#kbKeyAction,
QWidget#virtualKeyboard QPushButton#kbKeyMode {
    background-color: #1e293b;
    color: #38bdf8;
    border-color: #334155;
    font-weight: 900;
}

QWidget#virtualKeyboard QPushButton#kbKeySpace {
    background-color: #111d3d;
}

QDialog#virtualKeyboardDialog {
    background-color: #070d1e;
    border: 1.5px solid #38bdf8;
    border-radius: 8px;
}

QLabel#kbDialogTitle {
    color: #38bdf8;
    font-size: 12px;
    font-weight: 800;
}

QLineEdit#kbDialogInput {
    background-color: #0f1c3f;
    color: #ffffff;
    border: 1.5px solid #38bdf8;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 800;
}

QPushButton#kbDialogDoneBtn {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 900;
    padding: 6px 14px;
}

QPushButton#kbDialogCloseBtn {
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 14px;
}
