    background: rgba(7, 39, 42, 245);
    color: #bde2df;
    border: none;
    padding: 8px;
    font-size: 12px;
    font-weight: 950;
}
QLabel#iotMonitorOnline,
QLabel#iotMonitorDevice,
QLabel#iotMonitorEmpty {
    border-radius: 9px;
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 850;
    min-height: 42px;
}
QLabel#iotMonitorOnline {
    background: rgba(31, 111, 75, 150);
    color: #eafff4;
    border: 1px solid rgba(72, 222, 142, 120);
}
QLabel#iotMonitorDevice {
    background: rgba(18, 75, 92, 160);
    color: #e8fbff;
    border: 1px solid rgba(81, 191, 216, 110);
}
QLabel#iotMonitorEmpty {
    background: rgba(113, 49, 58, 150);
    color: #ffe7ea;
    border: 1px solid rgba(237, 103, 118, 120);
}
QFrame#iotMonitorItem {
    background: rgba(15, 67, 72, 230);
    border: 1px solid rgba(87, 201, 197, 95);
    border-radius: 20px;
}
QFrame#iotMonitorItem:hover {
    background: rgba(20, 88, 94, 245);
    border: 1px solid rgba(121, 247, 232, 185);
}
QFrame#iotMonitorItem[kind="user"] {
    background: rgba(19, 98, 72, 232);
    border: 1px solid rgba(76, 222, 142, 130);
}
QFrame#iotMonitorItem[kind="device"] {
    background: rgba(16, 80, 98, 235);
    border: 1px solid rgba(84, 193, 232, 125);
}
QFrame#iotMonitorItem[kind="empty"] {
    background: rgba(96, 49, 60, 235);
    border: 1px solid rgba(236, 105, 121, 125);
}
QLabel#iotMonitorItemIcon {
    border-radius: 26px;
    background: rgba(255, 255, 255, 22);
    color: #72f0e2;
    font-size: 23px;
    font-weight: 950;
}
QLabel#iotMonitorItemIcon[kind="user"] {
    color: #72f0b2;
}
QLabel#iotMonitorItemIcon[kind="empty"] {
    color: #ff9eaa;
}
QLabel#iotMonitorItemTitle {
    color: #ffffff;
    font-size: 16px;
    font-weight: 950;
}
QLabel#iotMonitorItemSubtitle {
    color: #bde2df;
    font-size: 12px;
    font-weight: 800;
}
QLabel#iotMonitorItemState {
    background: rgba(23, 133, 150, 185);
    color: #ffffff;
    border-radius: 12px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 950;
}
QLabel#iotMonitorItemState[kind="user"] {
    background: rgba(26, 172, 97, 185);
}
QLabel#iotMonitorItemState[kind="empty"] {
    background: rgba(190, 62, 78, 185);
}
QLabel#iotMonitorDeleteHint {
    color: #ff7785;
    font-size: 21px;
    font-weight: 950;
    min-width: 22px;
}
QFrame#iotMonitorItem:hover QLabel#iotMonitorDeleteHint {
    color: #ff7785;
}
QDialog#userActionDialog {
    background: transparent;
    border-radius: 28px;
}
QFrame#userActionProfilePanel {
    min-width: 315px;
    max-width: 315px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0f6c68, stop:0.5 #0d4648, stop:1 #062e30);
    border-top-left-radius: 28px;
    border-bottom-left-radius: 28px;
}
QFrame#userActionFormPanel {
    background: #ffffff;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
}
QLabel#userActionAvatar {
    background: rgba(230, 250, 250, 235);
    color: #0f5f5c;
    border: 8px solid rgba(255, 255, 255, 45);
    border-radius: 58px;
    min-width: 116px;
    min-height: 116px;
    font-size: 58px;
    font-weight: 950;
}
QLabel#userActionProfileTitle {
    color: white;
    font-size: 25px;
    font-weight: 950;
}
QLabel#userActionProfileHint {
    color: rgba(255, 255, 255, 190);
    font-size: 15px;
    font-weight: 750;
}
QLabel#userActionStatusTitle {
    color: white;
    font-size: 17px;
    font-weight: 950;
}
QLabel#userActionStatusOnline {
    color: #8ef1bd;
    font-size: 17px;
    font-weight: 950;
}
QLabel#userActionStatusLocked {
    color: #ffc06a;
    font-size: 17px;
    font-weight: 950;
}
QLabel#userActionStatusDevice {
    color: rgba(255, 255, 255, 190);
    font-size: 15px;
    font-weight: 850;
}
QLabel#userActionTitle {
    color: #172128;
    font-size: 28px;
    font-weight: 950;
}
QLabel#userActionHint {
    color: #4e5a61;
    font-size: 15px;
    font-weight: 650;
}
QLabel#userActionSmallHint {
    color: #526068;
    font-size: 12px;
    font-weight: 650;
}
QPushButton#userActionCloseButton {
    background: transparent;
    color: #3f464a;
    border: none;
    border-radius: 19px;
    font-size: 30px;
    font-weight: 900;
}
QPushButton#userActionCloseButton:hover {
    background: #f2f5f5;
    color: #d84a5c;
}
QLineEdit#userActionInput,
QComboBox#userActionCombo {
    background: #f4f6f9;
    color: #1d282e;
    border: 1px solid #ccd3da;
    border-radius: 12px;
    padding: 8px 14px;
    min-height: 38px;
    font-size: 14px;
    font-weight: 800;
}
QLineEdit#userActionInput:focus,
QComboBox#userActionCombo:focus {
    border: 2px solid #1495a0;
    background: white;
}
QCheckBox#userActionCheck {
    color: #28333a;
    font-size: 13px;
    font-weight: 800;
    spacing: 8px;
    min-height: 26px;
}
QLabel#userActionDeviceTitle {
    color: #172128;
    font-size: 16px;
    font-weight: 950;
    margin-top: 6px;
}
QLabel#userActionDeviceEmpty {
    background: #f4f6f7;
    color: #68757c;
    border-radius: 12px;
    padding: 10px 12px;
}
QFrame#userActionDeviceChip {
    background: #f1f7f8;
    border: 1px solid #cfe2e4;
    border-radius: 13px;
    min-height: 42px;
}
QLabel#userActionDeviceId {
    color: #143b40;
    font-size: 14px;
    font-weight: 950;
}
QLabel#userDetailTitle,
QLabel#userDetailSectionTitle {
    color: #e9f6f3;
    font-size: 20px;
    font-weight: 950;
}
QLabel#userDetailHint,
QLabel#userDeviceIdLabel {
    color: #bde2df;
    font-size: 12px;
    font-weight: 850;
}
QLabel#userDetailStat,
QFrame#userDeviceChip {
    background: rgba(9, 69, 72, 235);
    border: 1px solid rgba(64, 201, 195, 95);
    border-radius: 12px;
    color: #e9f6f3;
    padding: 9px 12px;
    font-size: 13px;
    font-weight: 950;
}
QPushButton#usersAddButton,
QPushButton#userPanelPrimaryButton,
QPushButton#userDeviceDetachButton {
    background: #1597a8;
    color: white;
    border-radius: 10px;
    border: none;
    min-height: 38px;
    font-size: 13px;
    font-weight: 950;
    padding-left: 14px;
    padding-right: 14px;
}
QPushButton#userPanelPrimaryButton:hover,
QPushButton#userDeviceDetachButton:hover {
    background: #1fb3c5;
}
QPushButton#userPanelSecondaryButton {
    background: #eef2f5;
    color: #18252c;
    border: 1px solid #cbd3da;
    border-radius: 10px;
    min-height: 38px;
    font-size: 13px;
    font-weight: 950;
    padding-left: 16px;
    padding-right: 16px;
}
QPushButton#userPanelSecondaryButton:hover {
    background: #e2e8ed;
    border: 1px solid #b7c2ca;
}
QPushButton#userPanelDangerButton {
    background: rgba(180, 47, 64, 60);
    color: #ff909d;
    border: 1px solid rgba(255, 100, 116, 90);
    border-radius: 10px;
    min-height: 38px;
    font-size: 13px;
    font-weight: 950;
    padding-left: 16px;
    padding-right: 16px;
}
QPushButton#userPanelDangerButton:hover {
    background: rgba(220, 64, 82, 90);
}

QDialog#confirmDeviceDialog {
    background: transparent;
}
QFrame#confirmDeviceProfilePanel {
    min-width: 315px;
    max-width: 315px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0f6c68, stop:0.5 #0d4648, stop:1 #062e30);
    border-top-left-radius: 28px;
    border-bottom-left-radius: 28px;
}
QFrame#confirmDeviceFormPanel {
    background: #ffffff;
    border-top-right-radius: 28px;
    border-bottom-right-radius: 28px;
}
QLabel#confirmDeviceIcon {
    background: rgba(230, 250, 250, 220);
    color: #0f5f5c;
    border-radius: 44px;
    min-width: 88px;
    min-height: 88px;
    font-size: 48px;
    font-weight: 950;
}
QLabel#confirmDeviceProfileTitle {
    color: white;
    font-size: 26px;
    font-weight: 950;
}
QLabel#confirmDeviceProfileHint {
    color: rgba(255, 255, 255, 190);
    font-size: 15px;
    font-weight: 750;
}
QLabel#confirmDeviceInfo {
    color: #ffffff;
    font-size: 16px;
    font-weight: 900;
    line-height: 130%;
}
QLabel#confirmDeviceWarning {
    color: rgba(255, 255, 255, 220);
    font-size: 14px;
    font-weight: 750;
}
QLabel#confirmDeviceTitle {
    color: #172128;
    font-size: 27px;
    font-weight: 950;
}
QLabel#confirmDeviceHint {
    color: #4e5a61;
    font-size: 16px;
    font-weight: 650;
}
QPushButton#confirmDeviceCloseButton {
    background: transparent;
    color: #3f464a;
    border: none;
    border-radius: 20px;
    font-size: 30px;
    font-weight: 900;
}
QPushButton#confirmDeviceCloseButton:hover {
    background: #f2f5f5;
    color: #d84a5c;
}
QLineEdit#confirmDeviceInput,
QComboBox#confirmDeviceCombo {
    background: #f4f6f9;
    color: #1d282e;
    border: 1px solid #ccd3da;
    border-radius: 12px;
    padding: 8px 14px;
    min-height: 38px;
    min-width: 350px;
    font-size: 15px;
    font-weight: 800;
}
QLabel#confirmDeviceQuestion {
    background: #f0f2f6;
    color: #111a20;
    border: 1px solid #ccd3da;
    border-radius: 14px;
    padding: 22px 24px;
    font-size: 24px;
    font-weight: 950;
}
QPushButton#confirmDevicePrimaryButton {
    background: #075245;
    color: white;
    border: none;
    border-radius: 12px;
    min-height: 48px;
    min-width: 170px;
    font-size: 17px;
    font-weight: 950;
}
QPushButton#confirmDevicePrimaryButton:hover {
    background: #08705f;
}
QPushButton#confirmDeviceCancelButton {
    background: transparent;
    color: #075245;
    border: none;
    border-radius: 12px;
    min-height: 48px;
    min-width: 120px;
    font-size: 17px;
    font-weight: 950;
}
QPushButton#confirmDeviceCancelButton:hover {
    background: #eef5f3;
}

/* LeNam analytics dashboard override */
QWidget#HistoryPage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #f7f4ff, stop:0.48 #f7fbff, stop:1 #eefcf7);
}
QFrame#historyChartCard {
    background: #ffffff;
    border: 1px solid rgba(124, 92, 255, 45);
    border-radius: 24px;
}
QFrame#historyStatCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ffffff, stop:1 #f4f7ff);
    border: 1px solid rgba(124, 92, 255, 45);
    border-radius: 22px;
}
QLabel#historyCardTitle {
    color: #17153b;
    font-size: 19px;
    font-weight: 950;
}
QLabel#historyChartHint {
    color: #718096;
    font-size: 12px;
    font-weight: 750;
}
QLabel#historyStatIcon {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ede8ff, stop:1 #e3fff6);
    color: #7c5cff;
    border-radius: 16px;
    font-size: 28px;
    min-width: 58px;
    max-width: 58px;
    min-height: 58px;
    max-height: 58px;
}
QLabel#historyStatTitle {
    color: #17153b;
    font-size: 14px;
    font-weight: 950;
}
QLabel#historyStatValue {
    color: #009f78;
    font-size: 16px;
    font-weight: 950;
}
QChartView#historyChart {
    background: transparent;
    border: none;
}
QChartView#historyMiniChart {
    background: #ffffff;
    border: 1px solid rgba(124, 92, 255, 35);
    border-radius: 16px;
}
QLabel#historyChartEmpty {
    background: #ffffff;
    color: #718096;
    border: 1px dashed rgba(124, 92, 255, 55);
    border-radius: 16px;
    min-height: 160px;
    font-size: 14px;
    font-weight: 850;
}
