/* =========================================================
   SMART ROOM LIGHTING & ILLUMINATION CONTROL (ESP32-S3 / 7-inch)
   Theme: Midnight Slate & Luminous Amber
   Target: 800 x 480 Touchscreen
   ========================================================= */

QMainWindow,
QWidget#centralWidget,
QWidget#LoginPage,
QWidget#DashboardPage,
QWidget#DeviceManagementPage,
QWidget#HistoryPage,
QWidget#UserManagementPage {
    background-color: #060b17;
    color: #e2e8f0;
    font-family: 'Segoe UI', 'Roboto', 'Noto Sans', sans-serif;
}

QStackedWidget#pages {
    background-color: #060b17;
}

/* --- Global Scrollbar Styling (Compact for 7-inch) --- */
QScrollBar:vertical {
    border: none;
    background: #090e1a;
    width: 6px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #1e293b;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #f59e0b;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #090e1a;
    height: 6px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #1e293b;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: #f59e0b;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Common Inputs & Dropdowns --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
    selection-background-color: #0284c7;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 1.5px solid #f59e0b;
    background-color: #111c33;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #1e293b;
}
QComboBox QAbstractItemView {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #334155;
    selection-background-color: #1e293b;
    selection-color: #f59e0b;
}

/* --- Tables & Headers --- */
QTableWidget {
    background-color: #0b1329;
    alternate-background-color: #111c38;
    border: 1px solid #1e293b;
    border-radius: 6px;
    gridline-color: #1e293b;
    color: #f8fafc;
    font-size: 11px;
}
QTableWidget::item {
    padding: 6px 8px;
    color: #f8fafc;
}
QTableWidget::item:alternate {
    background-color: #111c38;
    color: #f8fafc;
}
QHeaderView::section {
    background-color: #080d1a;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 800;
    padding: 6px 8px;
    border: none;
    border-bottom: 1.5px solid #1e293b;
}
QTableWidget::item:selected {
    background-color: #0284c7;
    color: #ffffff;
}

/* --- Tooltip --- */
QToolTip {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #38bdf8;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 10px;
}

/* --- LOGIN PAGE --- */
QWidget#LoginPage {
    background-color: #060b17;
}

QFrame#loginCard {
    background-color: #0c1527;
    border: 1.5px solid #1e293b;
    border-radius: 16px;
}

QLabel#welcomeLabel {
    color: #f8fafc;
    font-size: 18px;
    font-weight: 900;
}

QLabel#subtitleLabel {
    color: #94a3b8;
    font-size: 11px;
}

QPushButton#loginButton {
    background-color: #f59e0b;
    color: #020617;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 900;
    padding: 8px 16px;
}
QPushButton#loginButton:hover {
    background-color: #fbbf24;
}
QPushButton#loginButton:pressed {
    background-color: #d97706;
}

/* --- HISTORY PAGE STAT CARDS --- */
QFrame#historyChartCard {
    background-color: #0d1527;
    border: 1px solid #1e293b;
    border-radius: 8px;
}

QFrame#historyStatCard {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 8px;
}
QFrame#historyStatCard:hover {
    border-color: #f59e0b;
    background-color: #131f38;
}

QLabel#historyStatIcon {
    background-color: #1e293b;
    border-radius: 6px;
    padding: 6px;
    font-size: 14px;
    color: #f59e0b;
}

QLabel#historyStatTitle {
    color: #94a3b8;
    font-size: 9px;
    font-weight: 700;
}

QLabel#historyStatValue {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 900;
}

QLabel#historyRecordBadge {
    background-color: #0c1a2e;
    color: #38bdf8;
    border: 1px solid #0284c7;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 9px;
    font-weight: 800;
}
