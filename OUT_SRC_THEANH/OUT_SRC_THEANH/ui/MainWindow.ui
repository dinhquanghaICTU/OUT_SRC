      <property name="styleSheet">
       <string notr="true">
        QFrame#topConsoleBar {
          background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #09132c, stop:1 #060b18);
          border-bottom: 1.5px solid #1c2b54;
        }
        QLabel#appLogoLabel {
          border-radius: 4px;
        }
        QLabel#mainAppTitle {
          color: #38bdf8;
          font-size: 11px;
          font-weight: 900;
          letter-spacing: 0.3px;
        }
        QLabel#mainAppSubtitle {
          color: #94a3b8;
          font-size: 9px;
          font-weight: 600;
        }
        QLabel#headerBadgeGrid {
          background-color: rgba(16, 185, 129, 0.15);
          color: #34d399;
          border: 1px solid #059669;
          border-radius: 4px;
          padding: 2px 6px;
          font-size: 9px;
          font-weight: 800;
        }
        QLabel#headerBadgeDevice {
          background-color: rgba(56, 189, 248, 0.15);
          color: #38bdf8;
          border: 1px solid #0284c7;
          border-radius: 4px;
          padding: 2px 6px;
          font-size: 9px;
          font-weight: 800;
        }
        QPushButton#topNavDashboard,
        QPushButton#topNavHistory,
        QPushButton#topNavDevices,
        QPushButton#topNavUsers {
          background: #0f1c3f;
          color: #94a3b8;
          border: 1px solid #1c2b54;
          border-radius: 4px;
          font-size: 10px;
          font-weight: 700;
          padding: 4px 8px;
        }
        QPushButton#topNavDashboard:hover,
        QPushButton#topNavHistory:hover,
        QPushButton#topNavDevices:hover,
        QPushButton#topNavUsers:hover {
          background: #172554;
          color: #38bdf8;
          border-color: #38bdf8;
        }
        QPushButton#topNavDashboard:checked,
        QPushButton#topNavHistory:checked,
        QPushButton#topNavDevices:checked,
        QPushButton#topNavUsers:checked {
          background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #0369a1);
          color: #ffffff;
          border-color: #38bdf8;
          font-weight: 800;
        }
        QPushButton#topLogoutButton {
          background: #1e1b4b;
          color: #f87171;
          border: 1px solid #7f1d1d;
          border-radius: 4px;
          font-size: 9px;
          font-weight: 800;
          padding: 3px 8px;
        }
        QPushButton#topLogoutButton:hover {
          background: #dc2626;
          color: #ffffff;
        }
       </string>
