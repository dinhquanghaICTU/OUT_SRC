/* ==========================================================================
   DARK CYBER HUD THEME - 7 INCH EMBEDDED DISPLAY (800x480)
   OUT_SRC_TRUNGKIEN
   ========================================================================== */

* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", sans-serif;
    outline: none;
}

QMainWindow,
QWidget#LoginPage,
QWidget#DashboardPage,
QWidget#DeviceManagementPage,
QWidget#devicePageContent,
QWidget#deviceMainPanel,
QWidget#HistoryPage,
QWidget#AlertPage,
QWidget#UserManagementPage {
    background-color: #070d1e;
    color: #ecf2ff;
}

QLabel {
    color: #ecf2ff;
}

/* --- ScrollBars --- */
QScrollBar:vertical {
    background: #070d1e;
    width: 6px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #1e3a8a;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: #070d1e;
    height: 6px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #1e3a8a;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Sidebar --- */
QWidget#sideBar,
QFrame#sideBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0f1c3f, stop:1 #070d1e);
    border-right: 1.5px solid #1c2b54;
}

QWidget#sideBar QPushButton,
QFrame#sideBar QPushButton {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 800;
    text-align: left;
}

QWidget#sideBar QPushButton:hover,
QFrame#sideBar QPushButton:hover {
    background-color: #172554;
    color: #38bdf8;
}

QWidget#sideBar QPushButton:checked,
QFrame#sideBar QPushButton:checked {
    background-color: #0284c7;
    color: #ffffff;
    font-weight: 900;
}

QPushButton#sidebarToggleButton {
    background: #0e1938;
    color: #38bdf8;
    border: 1px solid #223565;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
}

/* --- Common Labels & Titles --- */
QLabel#devicePageTitle,
QLabel#usersPageTitle,
QLabel#dashboardTitle,
QLabel#historyCardTitle {
    color: #38bdf8;
    font-size: 15px;
    font-weight: 900;
}

QLabel#devicePageSubtitle,
QLabel#dashboardSubtitle,
QLabel#deviceSectionHint {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
}

QLabel#deviceSectionTitle {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 900;
}

QLabel#liveBadge,
QLabel#dashboardUpdatedAt {
    color: #10b981;
    font-size: 10px;
    font-weight: 900;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 2px 6px;
}

QLabel#deviceEmptyState {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
    padding: 12px;
}

/* --- Common Buttons & Tabs --- */
QPushButton#deviceViewTabButton,
QPushButton#dashboardTab {
    background: #0e1938;
    color: #cbd5e1;
    border: 1px solid #223565;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 800;
}

QPushButton#deviceViewTabButton:checked,
QPushButton#dashboardTabActive {
    background: #0284c7;
    color: #ffffff;
    border: 1px solid #38bdf8;
    font-weight: 900;
}

QPushButton#deviceViewTabButton:hover,
QPushButton#dashboardTab:hover {
    background: #1e293b;
    color: #ffffff;
}

QPushButton#historySearchButton,
QPushButton#usersAddButton,
QPushButton#claimDeviceSaveButton,
QPushButton#loginButton {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 900;
    padding: 5px 14px;
}

QPushButton#historySearchButton:hover,
QPushButton#usersAddButton:hover,
QPushButton#claimDeviceSaveButton:hover,
QPushButton#loginButton:hover {
    background-color: #059669;
}

QPushButton#refreshDevicesButton,
QPushButton#historyZoomButton {
    background-color: #0e1938;
    color: #38bdf8;
    border: 1px solid #223565;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
}

QPushButton#refreshDevicesButton:hover,
QPushButton#historyZoomButton:hover {
    background-color: #1e293b;
}

/* --- Inputs, Combos, DateEdits --- */
QLineEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #0f1c3f;
    color: #ffffff;
    border: 1px solid #233870;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 700;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1.5px solid #38bdf8;
}

QComboBox QAbstractItemView {
    background-color: #0e1938;
    color: #ffffff;
    selection-background-color: #0284c7;
    border: 1px solid #223565;
}

/* --- Badges & Pills --- */
QLabel#logStatBadge,
QLabel#historyRecordBadge {
    background: #0e1938;
    color: #94a3b8;
    border: 1px solid #1e293b;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#logStatBadgeOnline,
QLabel#historyRecordBadgeOnline {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 900;
}

QLabel#historyRecordBadgeOffline {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid #dc2626;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
    font-weight: 900;
}

QLabel#onlinePill {
    background: rgba(16, 185, 129, 0.2);
    color: #34d399;
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 9px;
    font-weight: 900;
}

QLabel#offlinePill {
    background: rgba(239, 68, 68, 0.2);
    color: #f87171;
    border: 1px solid #dc2626;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 9px;
    font-weight: 900;
}

/* --- Tables --- */
QTableWidget,
QTableView {
    background-color: #070d1e;
    alternate-background-color: #0f1c3f;
    color: #f8fafc;
    gridline-color: #1c2b54;
    border: 1px solid #1c2b54;
    border-radius: 6px;
    font-size: 11px;
}

QTableWidget QHeaderView::section,
QTableView QHeaderView::section {
    background-color: #0d1733;
    color: #38bdf8;
    font-weight: 800;
    font-size: 11px;
    padding: 6px 4px;
    border: none;
    border-right: 1px solid #1c2b54;
    border-bottom: 2px solid #0284c7;
}

QTableWidget::item,
QTableView::item {
    padding: 5px 6px;
    color: #f8fafc;
    border-bottom: 1px solid #142040;
}

QTableWidget::item:alternate,
QTableView::item:alternate {
    background-color: #0f1c3f;
    color: #f8fafc;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #0284c7;
    color: #ffffff;
}

/* --- Device Cards --- */
QFrame#ownedDeviceCard,
QFrame#availableDeviceCard {
    background-color: #0e1938;
    border: 1px solid #1c2b54;
    border-radius: 10px;
}

QFrame#ownedDeviceCard:hover,
QFrame#availableDeviceCard:hover {
    border-color: #38bdf8;
    background-color: #122149;
}

QLabel#deviceTypeIcon,
QLabel#availableDeviceIcon {
    font-size: 20px;
    color: #38bdf8;
    background: #0f1c3f;
    border: 1px solid #233870;
    border-radius: 8px;
    padding: 4px 8px;
}

QLabel#deviceCardName {
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
}

QLabel#deviceCardId,
QLabel#availableDeviceId {
    color: #94a3b8;
    font-size: 9px;
    font-weight: 600;
}

QLabel#devicePrimaryMetric {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 900;
}

QLabel#deviceSecondaryMetric,
QLabel#deviceCardType,
QLabel#availableDeviceHint {
    color: #cbd5e1;
    font-size: 9px;
    font-weight: 600;
}

QPushButton#claimDeviceButton {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 800;
    padding: 4px 8px;
}

QPushButton#claimDeviceButton:hover {
    background-color: #059669;
}

/* --- Dashboard Smart Cards & Scene Buttons --- */
QFrame#dashboardWeatherCard,
QFrame#dashboardSceneCard,
QFrame#dashboardMediaCard,
QFrame#dashboardCameraCard {
    background-color: #0d1733;
    border: 1px solid #1c2b54;
    border-radius: 8px;
}

QPushButton[objectName^="dashboardScene_"] {
    background-color: #0e1938;
    color: #ffffff;
    border: 1px solid #1c2b54;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 10px;
}

QPushButton[objectName^="dashboardScene_"]:hover {
    background-color: #172554;
    border-color: #38bdf8;
    color: #38bdf8;
}

QPushButton[objectName^="dashboardScene_"]:checked {
    background-color: #0284c7;
    color: #ffffff;
    border: 1.5px solid #38bdf8;
    font-weight: 900;
}

QFrame#dashboardMetricPill {
    background-color: #0e1938;
    border: 1px solid #223565;
    border-radius: 6px;
}

QLabel#dashboardClock {
    color: #ffffff;
    font-size: 20px;
    font-weight: 900;
    font-family: monospace;
}

QLabel#dashboardDate {
    color: #cbd5e1;
    font-size: 10px;
    font-weight: 700;
}

QLabel#dashboardWeatherChip {
    background: #0e1938;
    color: #38bdf8;
    border: 1px solid #223565;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 800;
}

QLabel#dashboardMetricSmallValue {
    color: #ffffff;
    font-size: 14px;
    font-weight: 900;
}

QLabel#dashboardMetricSmallUnit {
    color: #94a3b8;
    font-size: 9px;
    font-weight: 700;
}

/* --- History Page & Charts --- */
QFrame#historyChartCard {
    background-color: #0d1733;
    border: 1px solid #1c2b54;
    border-radius: 8px;
}

QFrame#historyStatCard {
    background-color: #0e1938;
    border: 1px solid #223565;
    border-radius: 6px;
}

QLabel#historyStatTitle {
    color: #cbd5e1;
    font-size: 9px;
    font-weight: 700;
}

QLabel#historyStatValue {
    color: #38bdf8;
    font-size: 12px;
    font-weight: 900;
}

/* --- User Management Detail Panel --- */
QFrame#userDetailPanel {
    background-color: #0d1733;
    border: 1px solid #1c2b54;
    border-radius: 8px;
}

/* --- Virtual Keyboard --- */
QWidget#virtualKeyboard {
    background-color: #0b152d;
    border-top: 1.5px solid #1c2b54;
}

QWidget#virtualKeyboard QPushButton {
    background-color: #172554;
    color: #ffffff;
    border: 1px solid #1e3a8a;
    border-radius: 5px;
    font-size: 13px;
    font-weight: 800;
    min-height: 28px;
}

QWidget#virtualKeyboard QPushButton:hover {
    background-color: #1d4ed8;
    border-color: #38bdf8;
}

QWidget#virtualKeyboard QPushButton:pressed {
    background-color: #0284c7;
}

QWidget#virtualKeyboard QPushButton#kbKeyAction,
QWidget#virtualKeyboard QPushButton#kbKeyMode {
    background-color: #1e293b;
    color: #38bdf8;
    border-color: #334155;
    font-weight: 900;
}

QWidget#virtualKeyboard QPushButton#kbKeySpace {
    background-color: #111d3d;
}

QDialog#virtualKeyboardDialog {
    background-color: #070d1e;
    border: 1.5px solid #38bdf8;
    border-radius: 8px;
}

QLabel#kbDialogTitle {
    color: #38bdf8;
    font-size: 12px;
    font-weight: 800;
}

QLineEdit#kbDialogInput {
    background-color: #0f1c3f;
    color: #ffffff;
    border: 1.5px solid #38bdf8;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 800;
}

QPushButton#kbDialogDoneBtn {
    background-color: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 900;
    padding: 6px 14px;
}

QPushButton#kbDialogCloseBtn {
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    padding: 6px 14px;
}

/* ==========================================================================
   GLOBAL DIALOGS & POPUPS (DARK CYBER THEME)
   ========================================================================== */
QDialog {
    background-color: #0b152d;
    color: #ecf2ff;
}

QMessageBox {
    background-color: #0b152d;
    color: #ecf2ff;
    border: 1.5px solid #1c2b54;
    border-radius: 8px;
}

QMessageBox QLabel {
    color: #ecf2ff;
    background-color: transparent;
    font-size: 12px;
    font-weight: 700;
    min-height: 36px;
}

QMessageBox QPushButton,
QDialogButtonBox QPushButton {
    background-color: #1e293b;
    color: #ecf2ff;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: 800;
    min-width: 75px;
    min-height: 28px;
}

QMessageBox QPushButton:hover,
QDialogButtonBox QPushButton:hover {
    background-color: #334155;
    border-color: #38bdf8;
    color: #38bdf8;
}

QMessageBox QPushButton:pressed,
QDialogButtonBox QPushButton:pressed {
    background-color: #0284c7;
    color: #ffffff;
}

/* Specific styling for claim device dialog */
QDialog#claimDeviceDialog {
    background-color: #0b152d;
    border: 1.5px solid #1c2b54;
    border-radius: 10px;
}

QWidget#claimBody {
    background-color: #0b152d;
}

QLabel#claimDeviceDialogTitle {
    color: #38bdf8;
    font-size: 15px;
    font-weight: 900;
}

QLabel#claimDeviceDialogHint {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
}

QLabel#claimDeviceDialogIcon {
    font-size: 26px;
    color: #38bdf8;
    background: #111d3d;
    border: 1px solid #233870;
    border-radius: 8px;
    padding: 6px 12px;
}

QLabel#claimDeviceInfo {
    color: #f59e0b;
    font-size: 11px;
    font-weight: 700;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid #b45309;
    border-radius: 6px;
    padding: 6px 10px;
}

QLineEdit#claimDeviceNameInput {
    background-color: #070d1e;
    color: #ffffff;
    border: 1.5px solid #233870;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 700;
    min-height: 28px;
}

QLineEdit#claimDeviceNameInput:focus {
    border-color: #38bdf8;
    background-color: #0f1c3f;
}

QPushButton#claimDeviceCancelButton {
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 800;
    min-height: 28px;
}

QPushButton#claimDeviceCancelButton:hover {
    background-color: #334155;
    color: #ffffff;
}

/* History Zoom Dialog */
QDialog#chartZoomDialog {
    background-color: #070d1e;
    border: 1.5px solid #1c2b54;
    border-radius: 10px;
}

QLabel#chartZoomTitle {
    color: #38bdf8;
    font-size: 15px;
    font-weight: 900;
}

QLabel#chartZoomSubtitle {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
}

/* ==========================================================================
   ERROR & ALERT POPUP DIALOGS (HIGH CONTRAST DARK CYBER THEME)
   ========================================================================== */
QDialog#errorDialog {
    background-color: transparent;
}

QWidget#errorCard {
    background-color: #0b152d;
    border: 2px solid #ef4444;
    border-radius: 12px;
}

QLabel#errorIcon {
    background-color: #dc2626;
    color: #ffffff;
    font-size: 20px;
    font-weight: 900;
    border-radius: 18px;
    border: 2px solid #f87171;
}

QLabel#errorTitle {
    color: #ef4444;
    font-size: 15px;
    font-weight: 900;
}

QLabel#errorMessage {
    color: #f8fafc;
    font-size: 13px;
    font-weight: 700;
}

QLabel#errorDetails {
    color: #fca5a5;
    background-color: #1a1024;
    border: 1px solid #7f1d1d;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
}

QPushButton#dialogDismissButton {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #f87171;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 800;
    min-width: 140px;
    min-height: 36px;
}

QPushButton#dialogDismissButton:hover {
    background-color: #ef4444;
    border-color: #ffffff;
}

QPushButton#dialogDismissButton:pressed {
    background-color: #b91c1c;
}

QPushButton#dialogCloseButton {
    background: transparent;
    color: #94a3b8;
    border: none;
    font-size: 20px;
    font-weight: bold;
    border-radius: 14px;
}

QPushButton#dialogCloseButton:hover {
    color: #ffffff;
    background-color: #1e293b;
}

/* --- Back Buttons --- */
QPushButton#deviceBackButton,
QPushButton#historyBackButton,
QPushButton#usersBackButton {
    background-color: #0f1c3f;
    color: #38bdf8;
    border: 1px solid #1c2b54;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 800;
    padding: 4px 10px;
    min-height: 24px;
}

QPushButton#deviceBackButton:hover,
QPushButton#historyBackButton:hover,
QPushButton#usersBackButton:hover {
    background-color: #0284c7;
    color: #ffffff;
    border-color: #38bdf8;
}

/* --- Device Settings Drawer --- */
QFrame#deviceDrawer,
QWidget#deviceDrawer {
    background-color: #081026;
    border-left: 1.5px solid #1c2b54;
}

QScrollArea#drawerScrollArea,
QWidget#drawerBodyWidget,
QWidget#drawerThresholdWidget {
    background-color: #081026;
    border: none;
}

QLabel#drawerTitle {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 800;
}

QPushButton#closeDrawerButton {
    background: #0f1c3f;
    color: #94a3b8;
    border: 1px solid #1c2b54;
    border-radius: 4px;
    font-size: 11px;
    font-weight: bold;
    padding: 3px 8px;
}

QPushButton#closeDrawerButton:hover {
    background: #dc2626;
    color: #ffffff;
}

QLabel#drawerDeviceName {
    color: #f8fafc;
    font-size: 12px;
    font-weight: 800;
}

QLabel#drawerDeviceId {
    color: #38bdf8;
    font-size: 9px;
    font-weight: 600;
}

QLabel#drawerMetrics {
    color: #7dd3fc;
    font-size: 10px;
    background-color: #0f1c3f;
    border: 1px solid #1c2b54;
    border-radius: 6px;
    padding: 6px;
}

QLabel#drawerSectionTitle {
    color: #38bdf8;
    font-size: 11px;
    font-weight: 800;
    padding-top: 6px;
}

QLabel#thresholdFieldLabel {
    color: #cbd5e1;
    font-size: 10px;
    font-weight: 700;
}

QPushButton#saveDeviceConfigButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0284c7, stop:1 #0369a1);
    color: #ffffff;
    border: 1px solid #38bdf8;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    padding: 8px 10px;
}

QPushButton#saveDeviceConfigButton:hover {
    background: #0284c7;
}

QPushButton#releaseDeviceButton {
    background: #1e1b4b;
    color: #f87171;
    border: 1px solid #7f1d1d;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    padding: 6px 10px;
}

QPushButton#releaseDeviceButton:hover {
    background: #dc2626;
    color: #ffffff;
}


